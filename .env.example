# Copia este fichero a .env y rellénalo. .env no se sube a git.

# Contraseña de PostgreSQL para docker compose (solo local).
POSTGRES_PASSWORD=

# guion = agentes con respuestas guionizadas, sin coste.  claude = Claude Agent SDK.
TELECO_AGENT_MODE=guion
TELECO_MODEL=claude-opus-5-5

# Solo para TELECO_AGENT_MODE=claude. Nunca la pongas en el código ni en los prompts.
ANTHROPIC_API_KEY=

# Radio de impacto por defecto (clientes) y segundos reales por cada tick de 15 minutos simulados.
TELECO_BLAST_RADIUS=500
TELECO_SIM_SECONDS_PER_TICK=10
